# Optional VM resource overrides for the current project.
# Copy this file to the target project's .env to customize its VM.
# The default is Small: 2 vCPUs and 4096 MiB.
# Uncomment exactly one size pair to override the default.

# Micro: 1 vCPU, 2048 MiB
# MSBX_VM_CPUS=1
# MSBX_VM_MEMORY_MIB=2048

# Small (default): 2 vCPUs, 4096 MiB
# MSBX_VM_CPUS=2
# MSBX_VM_MEMORY_MIB=4096

# Medium: 4 vCPUs, 8192 MiB
# MSBX_VM_CPUS=4
# MSBX_VM_MEMORY_MIB=8192

# Large: 8 vCPUs, 16384 MiB
# MSBX_VM_CPUS=8
# MSBX_VM_MEMORY_MIB=16384
